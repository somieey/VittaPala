# VittaPala backend configuration.
# Copy to .env and fill in real values. NEVER commit .env.

# MySQL connection. utf8mb4 is applied by the application.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/vittapala

# Log every SQL statement. Leave false outside debugging.
SQL_ECHO=false

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
